# ESP32-S3-WROOM N16R8: 16 MB quad flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/paperframe-dev.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/paperframe-dev.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# Keep the native USB Serial/JTAG console available for bring-up.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# app_main() is one flat function carrying substantial local state
# (carousel catalog buffers, decision/result tracking, presence
# bookkeeping); the 3584-byte ESP-IDF default overflowed once Phase 7
# added a few more locals, corrupting the return address into
# pf_storage::mount_all() (Guru Meditation InstrFetchProhibited,
# confirmed on real hardware 2026-07-31). 8192 was still not enough:
# the crash moved to post-WiFi init (vfs_littlefs_unlink backtrace).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Default of 10 left only 3 sockets for everything outside httpd's own
# reserved max_open_sockets=7 (see components/pf_web/health_server.cpp) --
# mDNS, SNTP, WeatherWorker, and pf_ota's esp_https_ota client (which needs
# 2-3 sequential connections per update, since GitHub's release download
# URL does a same-host then a cross-host redirect) all share that leftover
# budget. Confirmed on real hardware 2026-08-03: "立即更新" failed with
# esp-tls "Failed to create socket" while heap_caps_get_largest_free_block
# stayed at a flat 31744 bytes across the whole attempt (see
# docs/hardware/VALIDATION.md) -- ruling out memory pressure and pointing
# at CONFIG_LWIP_MAX_SOCKETS as the actual ceiling being hit, not heap.
CONFIG_LWIP_MAX_SOCKETS=16

# Phase 8 OTA (docs/adr/0008-ota-github-releases-and-rollback.md): lets the
# bootloader automatically revert to the previous OTA slot if the new
# firmware crash-loops before app_main.cpp calls
# esp_ota_mark_app_valid_cancel_rollback() (right after core services boot
# successfully).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
